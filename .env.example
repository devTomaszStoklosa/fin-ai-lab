# Copy to .env and fill in. Never commit .env.

# Gemini API key from aistudio.google.com/app/apikey. Free tier: Google may use
# submitted data to train its models — see docs/LLM-API.md before sending private data.
GEMINI_API_KEY=

# SEC EDGAR rejects requests without a User-Agent that identifies you, e.g. "fin-ai-lab you@example.com".
SEC_USER_AGENT=

# FRED - free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Optional: higher OpenFIGI limits (free), GUS BDL higher rate limit (free).
OPENFIGI_API_KEY=
GUS_BDL_API_KEY=

# ntfy.sh topic for market-pulse alerts (P3-S5) - pick something unguessable,
# the topic itself works like a password (no account, no API key). Free,
# no signup: https://docs.ntfy.sh/publish/#picking-a-topic
NTFY_TOPIC=

# Voyage embeddings are paid (no permanent free tier) - zero-cost policy means
# skip this unless you explicitly accept the cost; Gemini's own embedding model
# is free and is the default, see docs/LLM-API.md.
VOYAGE_API_KEY=

# Tracing (project 3) - Langfuse Cloud has a free tier with its own monthly cap;
# check the current limit before relying on it, otherwise leave empty to use
# local JSONL traces (always free, no cap).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Zero-cost policy: the Gemini key has no billing attached, so any run staying
# within the free tier always costs $0. This is a fail-safe, not the real guard -
# if a cost estimate ever comes back above 0 (e.g. billing got attached by
# accident), require confirmation / abort instead of silently continuing.
# The real guard against interrupted runs is request throttling in core.http,
# tuned to the free tier's RPM/RPD limits - see docs/LLM-API.md.
FIN_AI_LAB_MAX_RUN_COST_USD=0
