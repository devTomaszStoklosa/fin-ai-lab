# Copy to .env and fill in. Never commit .env.

# Gemini API key from aistudio.google.com/app/apikey. Free tier: Google may use
# submitted data to train its models — see docs/LLM-API.md before sending private data.
GEMINI_API_KEY=

# SEC EDGAR rejects requests without a User-Agent that identifies you, e.g. "fin-ai-lab you@example.com".
SEC_USER_AGENT=

# FRED - free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Optional: higher OpenFIGI limits, Voyage embeddings, GUS BDL higher rate limit.
OPENFIGI_API_KEY=
VOYAGE_API_KEY=
GUS_BDL_API_KEY=

# Tracing (project 3) - Langfuse Cloud keys, or leave empty to use local JSONL traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Spend guard: eval or batch runs estimated above this amount (USD) require confirmation.
FIN_AI_LAB_MAX_RUN_COST_USD=1.0
